{
  "id": "screen-shot-and-record",
  "name": "Screenshot, OCR & Record (Sway)",
  "version": "1.1.3",
  "minNoctaliaVersion": "3.6.0",
  "author": "Pulsar",
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A screenshot plugin with OCR, Google Lens integration, and screen recording for Sway.",
  "tags": [
    "Bar",
    "Panel",
    "Utility",
    "Sway"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml",
    "panel": "Panel.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "enableCross": true,
      "screenshotEditor": "swappy",
      "keepSourceScreenshot": false,
      "savePath": "~/Pictures/Screenshots",
      "recordingSavePath": "~/Videos",
      "recordingNotifications": true
    }
  }
}
