{
  "id": "caffeinate",
  "name": "Caffeinate",
  "version": "1.1.2",
  "minNoctaliaVersion": "4.7.7",
  "author": "Jostein Hanssen",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Pause idle actions for an arbitrary duration from the Noctalia launcher.",
  "tags": [
    "Bar",
    "Launcher",
    "System",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "launcherProvider": "LauncherProvider.qml",
    "barWidget": "BarWidget.qml",
    "panel": "BarWidget.qml",
    "settings": "Settings.qml?v=2"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "commandPrefix": "caffeinate",
    "defaultSettings": {
      "alias": "c",
      "presets": [
        "15m",
        "30m",
        "1h",
        "2h",
        "4h",
        "8h"
      ],
      "includeIndefinitePreset": true,
      "hideInactiveWidget": false
    }
  }
}
